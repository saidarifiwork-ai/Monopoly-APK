# Set these in Render > monopoly > Environment. Never commit real credentials.
# PostgreSQL connection string supplied by your hosted database (e.g. Neon).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
REQUIRE_DATABASE=true
# GOOGLE_CLIENT_ID is optional when google-client.json already has your Web ID.
# GOOGLE_CLIENT_ID=YOUR_PUBLIC_CLIENT_ID.apps.googleusercontent.com
# Optional private CA for a provider requiring a custom certificate:
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----...
